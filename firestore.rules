rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // A Member can read only their own record. Nobody can write from a client.
    match /members/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
    // pins/* and gate/* are used only by the Cloud Function (Admin SDK).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
